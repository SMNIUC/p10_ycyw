# ---------------------------------------------------------------------------------------------
# Variables d'environnement de la preuve de concept.
#
# Copier ce fichier en `.env` avant le premier demarrage :   cp .env.example .env
#
# `.env` est ignore par le gestionnaire de versions : aucun secret ne doit etre versionne, meme
# de developpement (constat F-13 de l'audit — des secrets deposes en fichiers de configuration).
# En production, ces valeurs proviennent d'un coffre-fort de secrets, jamais d'un fichier.
#
# Les valeurs ci-dessous sont des exemples LOCAUX. Les regenerer pour tout autre usage.
# ---------------------------------------------------------------------------------------------

# Base de donnees
POSTGRES_DB=ycyw
POSTGRES_USER=ycyw
POSTGRES_PASSWORD=changez-moi-en-local
# Port expose sur le poste. 5433 par defaut pour ne pas entrer en conflit avec un PostgreSQL
# deja installe localement, qui occuperait 5432.
POSTGRES_PORT=5433

# Broker de messages
RABBITMQ_USER=ycyw
RABBITMQ_PASSWORD=changez-moi-en-local

# Secret de signature des jetons de session — 32 octets minimum.
# En generer un :  openssl rand -base64 48
POC_JWT_SECRET=remplacez-ceci-par-une-valeur-aleatoire-de-32-octets-minimum

# Mot de passe des trois comptes de demonstration (profil `demo` uniquement).
POC_DEMO_PASSWORD=demo1234!
