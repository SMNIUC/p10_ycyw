<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.ycyw</groupId>
    <artifactId>ycyw-poc-assistance</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>YCYW PoC - Assistance</name>
    <description>Preuve de concept : messagerie temps réel client / agent (contexte borné Assistance)</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <archunit.version>1.3.0</archunit.version>
        <testcontainers.version>1.21.4</testcontainers.version>
        <bouncycastle.version>1.85.2</bouncycastle.version>
        <commons-compress.version>1.28.0</commons-compress.version>
        <!--
          Surcharge d'une version pilotée par le BOM Spring Boot, qui retient encore 3.17.0,
          vulnérable (CVE-2025-48924). Le BOM expose la propriété précisément pour cet usage : la
          redéfinir ici suffit, sans déclarer la dépendance.
        -->
        <commons-lang3.version>3.18.0</commons-lang3.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
              Testcontainers embarque encore commons-compress 1.24.0, vulnérable
              (CVE-2024-25710, CVE-2024-26308). La bibliothèque n'est jamais appelée directement
              ici : elle sert à Testcontainers pour construire les archives envoyées au moteur de
              conteneurs. On ne la déclare donc pas en dépendance, on impose seulement la version
              que la résolution transitive doit retenir.
            -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-compress</artifactId>
                <version>${commons-compress.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Adaptateurs primaires : REST et WebSocket/STOMP -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Sécurité : jeton signé transporté par cookie inaccessible au script (DA-18) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <!--
          Requis par Argon2PasswordEncoder : Spring Security délègue le calcul à cette
          bibliothèque. DA-17 retient Argon2id pour les empreintes de mot de passe ; sans cette
          dépendance, l'encodeur échoue au démarrage.
        -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>${bouncycastle.version}</version>
        </dependency>

        <!-- Adaptateur secondaire de persistance (DA-10) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Client TCP requis par le relais STOMP vers le broker externe (DA-11).
             C'est bien reactor-netty-http qu'il faut : le framework détecte la présence du relais
             à la classe reactor.netty.http.client.HttpClient, absente de reactor-netty-core. -->
        <dependency>
            <groupId>io.projectreactor.netty</groupId>
            <artifactId>reactor-netty-http</artifactId>
        </dependency>

        <!-- Observabilité minimale : sonde de vivacité pour l'orchestrateur -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Génération des accesseurs et constructeurs.
             Employé uniquement sur les entités de persistance et les services applicatifs, jamais
             dans le domaine : voir lombok.config et le README (§ 6.6). Portée "optional" : la
             bibliothèque disparaît à l'exécution, elle ne travaille qu'à la compilation. -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Vérification mécanique des frontières (DA-04) -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- La structure de données est vérifiée sur un vrai PostgreSQL, pas sur une base mémoire -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Les tests marqués "docker" exigent un moteur de conteneurs local.
                         Les exclure permet de lancer la boucle rapide : mvn test -DexcludedGroups=docker -->
                    <excludedGroups>${excludedGroups}</excludedGroups>
                    <!-- Autorise le chargement dynamique de l'agent utilisé par la bibliothèque de
                         doublures de test ; sans cela, la JVM émet un avertissement à chaque test. -->
                    <argLine>-XX:+EnableDynamicAgentLoading</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          S'active quand `excludedGroups` n'est PAS fourni en ligne de commande, et le définit alors
          à vide : n'exclure aucun groupe. Sans ce profil, `${excludedGroups}` resterait non résolu
          et Surefire chercherait un groupe littéralement nommé "${excludedGroups}".
          La balise auto-fermante porte donc une valeur vide voulue, pas un oubli.
        -->
        <profile>
            <id>default-groups</id>
            <activation><property><name>!excludedGroups</name></property></activation>
            <properties><excludedGroups/></properties>
        </profile>
    </profiles>
</project>
