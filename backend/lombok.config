# Configuration de la generation d'accesseurs.
#
# stopBubbling : ce fichier est la racine, aucune configuration parente n'est recherchee.
config.stopBubbling = true

# Marque le code genere d'une annotation dediee. Les outils de couverture de tests et d'analyse
# statique l'excluent alors de leurs mesures : un getter genere n'est ni du code a tester, ni un
# defaut de couverture.
lombok.addLombokGeneratedAnnotation = true

# Interdit les annotations les plus dangereuses sur une entite de persistance :
#  - @Data et @Value generent equals/hashCode sur tous les champs, y compris mutables et
#    associations : l'identite d'une entite deviendrait instable des qu'elle change d'etat ;
#  - @ToString traverse les associations et declenche des chargements differes, parfois hors
#    transaction.
# Les interdire ici evite d'avoir a le rappeler en revue.
lombok.data.flagUsage = error
lombok.value.flagUsage = error
lombok.toString.flagUsage = error
lombok.equalsAndHashCode.flagUsage = error
